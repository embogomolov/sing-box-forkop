{
  "dns": {
    "rules": [
      {
        "server": "remote",
        "query_type": [
          "A",
          "AAAA"
        ]
      },
      {
        "server": "local",
        "outbound": "any"
      }
    ],
    "fakeip": {
      "enabled": true,
      "inet4_range": "198.18.0.0/15",
      "inet6_range": "fc00::/18"
    },
    "servers": [
      {
        "tag": "cf-dns",
        "address": "tls://1.1.1.1"
      },
      {
        "tag": "local",
        "detour": "direct",
        "address": "tcp://1.1.1.1",
        "strategy": "ipv4_only",
        "address_strategy": "prefer_ipv4"
      },
      {
        "tag": "remote",
        "address": "fakeip"
      }
    ],
    "independent_cache": true
  },
  "log": {
    "level": "debug",
    "disabled": true,
    "timestamp": true
  },
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "mode": "or",
        "type": "logical",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "outbound": "direct",
        "ip_is_private": true
      }
    ],
    "override_android_vpn": true,
    "auto_detect_interface": true
  },
  "inbounds": [
    {
      "mtu": 9000,
      "tag": "tun-in",
      "type": "tun",
      "sniff": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "server": "127.0.0.1",
          "enabled": true,
          "server_port": 2412
        }
      },
      "auto_route": true,
      "strict_route": true,
      "inet4_address": "172.19.0.1/30",
      "inet6_address": "fdfe:dcba:9876::1/126",
      "interface_name": "tun125",
      "endpoint_independent_nat": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "sniff": true,
      "users": [],
      "listen": "127.0.0.1",
      "listen_port": 2412,
      "set_system_proxy": false
    }
  ],
  "experimental": {
    "clash_api": {
      "external_ui": "yacd",
      "default_mode": "rule",
      "external_controller": "127.0.0.1:9090",
      "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
      "external_ui_download_detour": "direct"
    },
    "cache_file": {
      "path": "remnawave.db",
      "enabled": true,
      "cache_id": "remnawave",
      "store_fakeip": true
    }
  },
  "outbounds": [
    {
      "tag": "→ Remnawave",
      "type": "selector",
      "outbounds": [
        "🇪🇪 Estonia",
        "🇱🇻 Latvia",
        "🇩🇪 Germany"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "type": "vless",
      "tag": "🇪🇪 Estonia",
      "server": "ee.example.test",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000001",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "public-key-1",
          "short_id": "3fca1964759edc55"
        },
        "server_name": "ee.example.test",
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        }
      }
    },
    {
      "type": "vless",
      "tag": "🇱🇻 Latvia",
      "server": "lva.example.test",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000002",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "public-key-2",
          "short_id": "3fca1964759edc55"
        },
        "server_name": "lva.example.test",
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        }
      }
    },
    {
      "type": "vless",
      "tag": "🇩🇪 Germany",
      "server": "de.example.test",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000003",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "public-key-3",
          "short_id": "3fca1964759edc55"
        },
        "server_name": "de.example.test",
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        }
      }
    }
  ]
}
