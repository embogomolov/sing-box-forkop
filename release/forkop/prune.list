# Paths of upstream sing-box and of the third_party modules this core does not
# carry. release/forkop/prune.sh deletes them after every upstream merge and
# release/forkop/third-party.sh leaves them out of a module move; nothing kept
# may import them. Patterns are git
# pathspecs, one per line; a comment says why the group goes.
# release/forkop/check-tree.sh fails on a Go file no stock build compiles and on a
# package no stock build links: such a path belongs here.

# Documentation, integration tests, lint settings and the build machinery of
# upstream releases: this core builds with build.sh.
docs
mkdocs.yml
test
.golangci.yml
Dockerfile
Dockerfile.binary
Makefile
.fpm_openwrt
.fpm_pacman
.fpm_systemd
.github/FUNDING.yml
.github/workflows/build.yml
.github/workflows/docker.yml
.github/workflows/lint.yml
.github/workflows/linux.yml
.github/workflows/stale.yml
.github/workflows/test.yml
.github/ISSUE_TEMPLATE
.github/build_alpine_apk.sh
.github/build_openwrt_apk.sh
.github/deb2ipk.sh
.github/detect_track.sh
.github/go_ios_cpu_features.patch
.github/patch_go_for_ios.sh
.github/renovate.json
.github/setup_go_for_macos1013.sh
.github/setup_go_for_windows7.sh
.github/update_clients.sh
.github/update_cronet.sh
.github/update_cronet_dev.sh
.github/update_dependencies.sh
